page {
  min-height: 100%;
  background: #f7faf8;
  color: #17231c;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 48rpx;
}

.page-title {
  margin: 8rpx 0 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-subtitle {
  margin: 0 0 32rpx;
  color: #5a6b61;
  font-size: 28rpx;
  line-height: 1.5;
}

.panel {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #dce8df;
  border-radius: 16rpx;
  background: #ffffff;
}

.panel-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.panel-desc {
  display: block;
  color: #66756c;
  font-size: 26rpx;
  line-height: 1.5;
}

.placeholder {
  color: #66756c;
  font-size: 28rpx;
  line-height: 1.6;
}
