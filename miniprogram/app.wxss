page {
  min-height: 100%;
  overflow-x: hidden;
  background: #f7faf8;
  color: #17231c;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 48rpx;
  overflow-x: hidden;
}

.page-title {
  margin: 8rpx 0 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-subtitle {
  margin: 0 0 32rpx;
  color: #5a6b61;
  font-size: 28rpx;
  line-height: 1.5;
}

.panel {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #dce8df;
  border-radius: 16rpx;
  background: #ffffff;
}

.panel-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.panel-desc {
  display: block;
  color: #66756c;
  font-size: 26rpx;
  line-height: 1.5;
}

.placeholder {
  color: #66756c;
  font-size: 28rpx;
  line-height: 1.6;
}

.auth-panel {
  padding-bottom: 32rpx;
}

.avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 28rpx 0 24rpx;
  padding: 0;
  border: 1rpx solid #dce8df;
  border-radius: 66rpx;
  background: #f7faf8;
  color: #66756c;
  font-size: 24rpx;
}

.avatar-button::after {
  border: 0;
}

.avatar-preview {
  width: 132rpx;
  height: 132rpx;
  border-radius: 66rpx;
}

.avatar-placeholder {
  color: #66756c;
}

.nickname-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dce8df;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.primary-button {
  width: 100%;
  margin: 0;
  border-radius: 12rpx;
  background: #2f8f57;
  color: #ffffff;
  font-size: 30rpx;
}

.primary-button::after {
  border: 0;
}

.auth-error {
  display: block;
  margin-top: 18rpx;
  color: #b54708;
  font-size: 26rpx;
  line-height: 1.5;
}
