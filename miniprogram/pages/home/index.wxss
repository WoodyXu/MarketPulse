.home-page {
  padding-top: 56rpx;
}

.board-entry {
  position: relative;
}

.board-entry::after {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #2f8f57;
  border-right: 3rpx solid #2f8f57;
  content: "";
  transform: translateY(-50%) rotate(45deg);
}
